meta {
  name: Get Unread Count
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/notifications/unread-count
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("unreadCount ada di response", function() {
    expect(res.body.unreadCount).to.be.a("number");
  });
}
