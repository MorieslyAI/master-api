meta {
  name: Get Bio-Synergy Report
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/bio-synergy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("bentuk response benar", function() {
    expect(res.body).to.have.property("report");
    expect(res.body.canGenerate).to.be.a("boolean");
  });
}
