meta {
  name: Generate Bio-Synergy Report (1x / 24 jam)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/bio-synergy/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "localDate": "2026-09-21"
  }
}

docs {
  Jalankan pertama kali -> 200 + report, canGenerate=false.
  Jalankan lagi dalam 24 jam -> 409 code BIO_SYNERGY_COOLDOWN, tetap membawa report + nextAvailableAt.
}

tests {
  test("200 (pertama) atau 409 (dalam cooldown)", function() {
    expect([200, 409]).to.include(res.status);
  });

  test("report selalu ikut di response", function() {
    expect(res.body.report.text).to.be.a("string");
    expect(res.body.canGenerate).to.equal(false);
    expect(res.body.nextAvailableAt).to.be.a("string");
  });
}
