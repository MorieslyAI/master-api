meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "iqbal@mail.com",
    "password": "iqbal123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("accessToken ada di response", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
  
  test("expiresIn ada di response", function() {
    expect(res.body.expiresIn).to.be.a("number");
  });
}
