meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "ballee@mail.com",
    "password": "Password123!",
    "displayName": "Test User"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("accessToken", res.body.accessToken);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  
  test("accessToken ada di response", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
  
  test("expiresIn ada di response", function() {
    expect(res.body.expiresIn).to.be.a("number");
  });
}
