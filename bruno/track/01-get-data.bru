meta {
  name: Get Track Data
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/track/data
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("goal & weightHistory ada di response", function() {
    expect(res.body.goal).to.be.an("object");
    expect(res.body.weightHistory).to.be.an("array");
  });
}
