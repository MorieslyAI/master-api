meta {
  name: Explore - Create Post
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/explore/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "content": "Just hit my sugar goal for the 3rd day in a row!",
    "type": "post"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("explorePostId", res.body.id);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("post id ada di response", function() {
    expect(res.body.id).to.be.a("string");
  });
}
