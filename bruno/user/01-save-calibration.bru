meta {
  name: Save Calibration
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user/calibration
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

# Contoh payload lengkap: Pria, 25 tahun, desk job, kondisi normal, goal cut
body:json {
  {
    "name": "Budi Santoso",
    "gender": "male",
    "age": 25,
    "height": 172,
    "weight": 75,
    "archetypeId": "desk",
    "medicalConditions": [],
    "goalMode": "cut"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("pesan berhasil", function() {
    expect(res.body.message).to.include("Kalibrasi");
  });

  test("sugarLimit dihitung dan ada di response", function() {
    expect(res.body.sugarLimit).to.be.a("number");
    expect(res.body.sugarLimit).to.be.above(0);
  });
}
