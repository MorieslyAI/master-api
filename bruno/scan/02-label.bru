meta {
  name: Scan Label
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

# Butuh gambar JPEG asli sebagai base64 (tanpa prefix "data:") di var testImageBase64,
# lihat bruno/environments/Local.bru.
body:json {
  {
    "scanMode": "label",
    "base64Image": "{{testImageBase64}}"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("success true", function() {
    expect(res.body.success).to.equal(true);
  });
}
