meta {
  name: Start Video Call Session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chat/video/sessions/start
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("videoSessionId", res.body.sessionId);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("sessionId ada di response", function() {
    expect(res.body.sessionId).to.be.a("string");
  });
}
