meta {
  name: Get Video Call Quota
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/chat/video/quota
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("policy ada di response", function() {
    expect(res.body.policy).to.be.an("object");
    expect(res.body.remainingCallsToday).to.be.a("number");
  });
}
